// Proto to test proto3 oneofs.
syntax = "proto2";

package proto_util_converter.testing.oneofs;

import "shark/types/any.shark";
import "shark/types/struct.shark";
import "shark/types/timestamp.shark";

message OneOfsRequest {
  optional string value = 1;
  oneof data {
    string str_data = 2;
    int32 int_data = 3;
    // Simple message
    Data message_data = 4;
    MoreData more_data = 5;
    // Well known types
    shark.Struct struct_data = 6;
    shark.Value value_data = 7;
    shark.ListValue list_value_data = 8;
    shark.Timestamp ts_data = 9;
  }
  optional shark.Any any_data = 19;
}

message RequestWithSimpleOneof {
  optional string value = 1;
  oneof data {
    string str_data = 2;
    int32 int_data = 3;
    Data message_data = 4;
    MoreData more_data = 5;
  }
}

message Data {
  optional int32 data_value = 1;
}

message MoreData {
  optional string str_value = 1;
}

message Response {
  optional string value = 1;
}
