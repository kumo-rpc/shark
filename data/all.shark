edition = "sk2026";

annotation@ scope = "file";
annotation@.cpp header = "shark/all.h";

package.cpp "shark.parser";
package "shark.parser";

import "shark/cpp.shark";
import.cpp "shark/cpp.shark";
import.go "shark/cpp.shark";

constexpr int32 kLimit @ 1 = 64;
constexpr string kName @ 2 = "shark";
constexpr Point kOrigin @ 3 = { x = 0, y = 0, };

annotation key = "color";
enum class Color : uint16 {
    annotation key = "red";
    RED = 0; //! red
    GREEN = 1;
    BLUE = 2;
};

annotation key = "point";
struct Point {
    required int64 x @ 1 = 0;
    optional int64 y @ 2;
    atomic int32 z @ 3 = 1;
    constexpr int32 zero @ 4 = 0;

    enum class Kind : int32 {
        NONE = 0;
        FILE = 1;
    };

    struct Inner {
        optional string name @ 1 = "inner";
    };

    union Choice {
        optional int64 i @ 1;
        optional string s @ 2;
    };
};

union Payload {
    required int64 number @ 1;
    optional string text @ 2 = "text";
};

annotation key = "add";
function int64 add(
    required int64 a @ 1,
    optional int64 b @ 2 = 0,
);

function void ping();

servlet Read {
    function int64 get(required string key @ 1);
};

annotation key = "query";
servlet Query : shark.io.Read, shark.io.Write, {
    function void ping();
    function int64 add(
        required int64 a @ 1,
        optional int64 b @ 2 = 0,
    );
};


struct CppAttr {
    optional int32 level @1;
    optional bool  export @2;
}

/// export from cpp
annotation.cpp extern = true;
annotation.cpp include = "shark/sub.h";
annotation.cpp namespace = "shark.math";
annotation.cpp cppattr<CppAttr> = {level = 0,export = false};
annotation.cpp ids<list<int32>> = [1, 2, 3];
annotation.cpp names<list<string>> = ["shark", "math"];
annotation.cpp flags<set<bool>> = [true, false];
annotation.cpp table<map<string, int32>> = {"limit" = 64, "zero" = 0};
annotation.cpp attrs<map<string, CppAttr>> = {"core" = {level = 1, export = true}};
annotation.cpp points<list<Point>> = [{x = 1, y = 2}, {x = 3, y = 4}];

function void sub(required int64 a @ 1,
                   optional int64 b @ 2);

struct Slot<T[is_integer]> {
    optional T n @ 1;
};

struct Pair<K[is_integer or is_string or has_hash], V[not is_void and is_subclass_of<Point>]> {
    optional list<K> keys @ 1;
    optional list<int32> key32 @ 3;
    optional map<string, Point> values @ 2;
};

struct Holder {
    optional Slot<int32> slot @ 1;
    optional list<Point> items @ 2;
    optional map<string, Point> index @ 3;
    optional Pair<int32, Point> pair @ 4;
};

function<K> K identity(required K value @ 1);

function<K[is_integer], V[is_subclass_of<Point>]> V pick(
    required K key @ 1,
    required V value @ 2,
);

function<K[(is_integer or is_string) and not is_void]> K keep(required K value @ 1);

servlet Store<T[is_integer]> {
    function void ping();
    function void agg(required T key @ 1);
    function<K> void agg(required T key @ 1,required K value @ 2);
};

servlet IntStore : Store<int32> {
    function void ping();
};

struct TestConstrain {

}